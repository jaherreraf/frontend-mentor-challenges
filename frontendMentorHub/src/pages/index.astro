---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import HubHeader from "@/components/fm-hub/HubHeader.astro";
import SearchBar from "@/components/fm-hub/SearchBar.astro";
import FilterBar from "@/components/fm-hub/FilterBar.astro";
import StatsPanel from "@/components/fm-hub/StatsPanel.astro";
import ProjectsGrid from "@/components/fm-hub/ProjectsGrid.astro";
import { FM_PROFILE_URL } from "@/data/fm-filters";
import { levelIndex } from "@/lib/bento-grid";

// Static import replaced by collection query
const projectEntries = await getCollection("projects");
const projects = projectEntries
    .map((entry) => ({
        id: entry.slug,
        ...entry.data,
    }))
    .sort((a, b) => {
        const levelDiff = levelIndex(b.difficultyLevel) - levelIndex(a.difficultyLevel);
        if (levelDiff !== 0) return levelDiff;
        return Number(b.isFeatured) - Number(a.isFeatured);
    });
---

<Layout title="Frontend Mentor Hub | Dashboard">
    <div id="dashboard-root" class="max-w-7xl mx-auto space-y-10">
        <header
            class="flex flex-col lg:flex-row lg:items-end justify-between gap-6"
        >
            <HubHeader />
            <div
                class="flex flex-col gap-3 w-full lg:w-auto items-start lg:items-end"
            >
                <SearchBar />
                <FilterBar />
            </div>
        </header>

        <StatsPanel projects={projects} />
        <ProjectsGrid projects={projects} />

        <p
            id="no-results"
            class="hidden text-center text-gray-500 text-sm py-10 font-mono"
        >
            $ no results found for your search
        </p>

        <footer
            class="text-center text-gray-500 text-sm pt-6 border-t border-white/5 space-y-2"
        >
            <a
                href={FM_PROFILE_URL}
                target="_blank"
                rel="noopener"
                class="text-violet-400 hover:text-violet-300 font-semibold block"
            >
                See all my challenges on Frontend Mentor →
            </a>
            <p>Frontend Mentor Hub &copy; 2026 — Built with Astro & Tailwind</p>
        </footer>
    </div>

    <script>
        import { initFmHubFilters } from "@/scripts/fm-hub-filters.client";
        initFmHubFilters();
    </script>
</Layout>
