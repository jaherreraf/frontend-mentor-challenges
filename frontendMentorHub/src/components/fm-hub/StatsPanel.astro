---
import type { Project } from "@/types/project.types";
import { getProjectStats } from "@/lib/bento-grid";

interface Props {
    projects: Project[];
}

const { projects } = Astro.props;
const stats = getProjectStats(projects);

const TECH_ORDER = ["Vue", "React", "Astro", "Vainilla"] as const;
const LEVEL_ORDER = [
    "Newbie",
    "Junior",
    "Intermediate",
    "Advanced",
    "Guru",
] as const;

const levelBarColor = (level: string) => {
    if (level === "Advanced" || level === "Guru") return "bg-red-400";
    if (level === "Intermediate") return "bg-amber-400";
    if (level === "Junior") return "bg-sky-400";
    return "bg-emerald-400"; // Newbie
};

const maxLevelCount = Math.max(
    ...LEVEL_ORDER.map((l) => stats.difficultyCounts[l]),
    1,
);
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
    <!-- Main panel: overview + stack, each number appears ONCE -->
    <div
        class="md:col-span-2 lg:col-span-2 animated-border rounded-3xl glow-on-hover"
    >
        <div
            class="bento-card p-6 md:p-8 rounded-3xl h-full flex flex-col justify-between relative overflow-hidden"
        >
            <div
                class="absolute top-0 right-0 w-64 h-64 bg-violet-600/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"
            >
            </div>

            <div class="space-y-1 relative z-10">
                <span
                    class="text-xs font-semibold text-violet-400 uppercase tracking-widest"
                    >Overview</span
                >
                <h2 class="text-2xl md:text-3xl font-bold">Project Metrics</h2>
            </div>

            <div class="flex items-end gap-8 mt-6 relative z-10">
                <div class="space-y-1">
                    <span class="text-4xl md:text-5xl font-bold text-white"
                        >{stats.total}</span
                    >
                    <p class="text-xs text-gray-400 uppercase tracking-wider">
                        Total Projects
                    </p>
                </div>
                <div class="space-y-1">
                    <span class="text-4xl md:text-5xl font-bold text-white"
                        >{stats.featuredCount}</span
                    >
                    <p class="text-xs text-gray-400 uppercase tracking-wider">
                        Featured
                    </p>
                </div>
            </div>

            <div class="mt-6 relative z-10">
                <p class="text-xs text-gray-500 uppercase tracking-wider mb-2">
                    Projects by Stack
                </p>
                <div class="flex flex-wrap gap-2">
                    {
                        TECH_ORDER.map((tech) => (
                            <span class="text-xs font-medium px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-gray-300">
                                {tech}{" "}
                                <span class="text-white font-bold ml-1">
                                    {stats.techStackCounts[tech]}
                                </span>
                            </span>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2: Favorites (only place this number appears) -->
    <div class="animated-border rounded-3xl glow-on-hover">
        <div
            class="bento-card p-6 rounded-3xl h-full flex flex-col justify-between"
        >
            <span
                class="text-xs font-semibold text-violet-400 uppercase tracking-widest"
                >Favorites</span
            >
            <div class="mt-4">
                <span class="text-3xl font-bold">{stats.featuredCount}</span>
                <p class="text-sm text-gray-400 mt-1">
                    of {stats.total} projects marked as featured
                </p>
            </div>
        </div>
    </div>

    <!-- Card 3: difficulty distribution — NEW info, does not repeat Guru/Adv standalone -->
    <div class="animated-border rounded-3xl glow-on-hover">
        <div
            class="bento-card p-6 rounded-3xl h-full flex flex-col justify-between"
        >
            <span
                class="text-xs font-semibold text-violet-400 uppercase tracking-widest"
                >By Difficulty</span
            >
            <div class="mt-4 space-y-2">
                {
                    LEVEL_ORDER.map((level) => (
                        <div class="flex items-center gap-2">
                            <span class="text-[10px] text-gray-500 w-16 shrink-0">
                                {level}
                            </span>
                            <div class="flex-1 h-1.5 rounded-full bg-white/5 overflow-hidden">
                                <div
                                    class={`h-full rounded-full ${levelBarColor(level)}`}
                                    style={`width: ${(stats.difficultyCounts[level] / maxLevelCount) * 100}%`}
                                />
                            </div>
                            <span class="text-xs font-semibold text-gray-300 w-4 text-right">
                                {stats.difficultyCounts[level]}
                            </span>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</div>
