---
import { DIFFICULTY_LEVELS, TOOLS } from "@/data/fm-filters";
---

<div class="flex flex-wrap gap-2" id="difficulty-filter-bar">
    {
        DIFFICULTY_LEVELS.map((level) => (
            <button
                data-difficulty={level}
                class="filter-btn difficulty-btn px-4 py-1.5 rounded-full text-xs font-semibold border border-white/10 bg-[#1A1A1F] text-gray-300 hover:border-violet-500/50 transition-all duration-300"
            >
                {level}
            </button>
        ))
    }
</div>
<div class="flex flex-wrap gap-2" id="tool-filter-bar">
    {
        TOOLS.map((tool) => (
            <button
                data-tool={tool}
                class="filter-btn tool-btn px-4 py-1.5 rounded-full text-xs font-semibold border border-white/10 bg-[#1A1A1F] text-gray-300 hover:border-violet-500/50 transition-all duration-300"
            >
                {tool}
            </button>
        ))
    }
    <button
        id="favorite-toggle"
        class="px-4 py-1.5 rounded-full text-xs font-semibold border border-white/10 bg-[#1A1A1F] text-gray-300 hover:border-violet-500/50 transition-all duration-300"
    >
        ★ Favorites
    </button>
</div>
