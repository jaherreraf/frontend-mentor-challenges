---
import type { Project } from "@/types/project.types";
import { getPlaceholderSlots } from "@/lib/bento-grid";
import ProjectCard from "./ProjectCard.astro";
import PlaceholderCard from "./PlaceholderCard.astro";
interface Props {
    projects: Project[];
}
const { projects } = Astro.props;
const placeholderSlots = getPlaceholderSlots(projects.length);
---

<div class="projects-bento grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">
    {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    {
        placeholderSlots.map((slot) => (
            <PlaceholderCard column={slot.column} rowSpan={slot.rowSpan} />
        ))
    }
</div>
<style>
    @media (min-width: 1024px) {
        .projects-bento {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            grid-auto-rows: 280px;
            grid-auto-flow: row dense;
        }
        .projects-bento > :global(.bento-item):nth-child(5n + 1) {
            grid-column: 1;
            grid-row: span 2;
        }
        .projects-bento > :global(.bento-item):nth-child(5n + 2) {
            grid-column: 2 / span 2;
            grid-row: span 1;
        }
        .projects-bento > :global(.bento-item):nth-child(5n + 3) {
            grid-column: 2;
            grid-row: span 1;
        }
        .projects-bento > :global(.bento-item):nth-child(5n + 4) {
            grid-column: 3;
            grid-row: span 1;
        }
        .projects-bento > :global(.bento-item):nth-child(5n) {
            grid-column: 4;
            grid-row: span 2;
        }
    }
</style>
