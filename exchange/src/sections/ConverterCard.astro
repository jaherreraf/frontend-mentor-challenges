---
import CurrencyPicker from "../components/currency/CurrencyPicker.astro"

interface Props {
  stats: { last: number }
  from: string
  to: string
  currencyList: [string, string][]
}

const { stats, from, to, currencyList } = Astro.props
---

<section class="bg-(--color-card) rounded-xl border border-(--color-border) p-4 sm:p-6">
  <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto_1fr] gap-3 items-center">
    <div class="bg-(--color-card-alt) rounded-lg border border-(--color-border) p-4 flex flex-col gap-3">
      <span class="text-[10px] font-semibold tracking-widest text-(--color-text-muted) uppercase">Send</span>
      <div class="flex items-center justify-between gap-2">
        <input
          type="number"
          value="1000"
          min="0"
          id="send-amount"
          class="bg-transparent text-2xl sm:text-3xl font-bold text-(--color-text-primary) w-full min-w-0 outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
        />
        <CurrencyPicker panel="send" currencies={currencyList} selected={from} />
      </div>
    </div>

    <button
      id="swap-btn"
      aria-label="Swap currencies"
      class="size-10 mx-auto sm:mx-0 flex items-center justify-center rounded-full bg-(--color-swap-bg) hover:bg-(--color-input) border border-(--color-border) transition-colors rotate-90 sm:rotate-0"
    >
      <img src="/assets/icons/icon-exchange.svg" alt="" class="size-4" />
    </button>

    <div class="bg-(--color-card-alt) rounded-lg border border-(--color-border) p-4 flex flex-col gap-3">
      <span class="text-[10px] font-semibold tracking-widest text-(--color-text-muted) uppercase">Receive</span>
      <div class="flex items-center justify-between gap-2">
        <span id="receive-amount" class="text-2xl sm:text-3xl font-bold text-(--color-accent-lime) truncate">
          {(stats.last * 1000).toFixed(2)}
        </span>
        <CurrencyPicker panel="receive" currencies={currencyList} selected={to} />
      </div>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mt-4">
    <span id="rate-label" class="text-xs text-(--color-text-muted)">
      1 {from} = {stats.last.toFixed(4)} {to}
    </span>
    <div class="flex items-center gap-2">
      <button id="favorite-btn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-(--color-accent-lime) text-(--color-main) text-xs font-bold hover:brightness-110 transition-all">
        <svg class="size-3" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <span id="favorite-label">Favorited</span>
      </button>
      <button id="log-btn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-(--color-border) text-(--color-text-muted) text-xs font-semibold hover:border-(--color-border-hover) hover:text-(--color-text-primary) transition-all">
        Log conversion
      </button>
    </div>
  </div>
</section>

<style>
  #send-dropdown,
  #receive-dropdown {
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }
  #send-dropdown::-webkit-scrollbar,
  #receive-dropdown::-webkit-scrollbar { width: 4px; }
  #send-dropdown::-webkit-scrollbar-thumb,
  #receive-dropdown::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 2px;
  }
</style>
