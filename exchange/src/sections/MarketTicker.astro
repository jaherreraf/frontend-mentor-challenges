---
import type { TickerPair } from "../lib/api/frankfurter"
import ChangeIndicator from "../components/currency/ChangeIndicator.astro"

interface Props {
  pairs: TickerPair[]
}

const { pairs } = Astro.props
---

<div class="flex items-center h-10 sm:h-11 w-full bg-(--color-ticker) border-b border-(--color-border) overflow-hidden">
  <div class="shrink-0 flex items-center gap-1.5 sm:gap-2 h-full px-2.5 sm:px-4 bg-(--color-accent-lime) border-r border-(--color-border) z-10">
    <span class="size-2 rounded-full bg-(--color-live-bg) animate-pulse"></span>
    <span class="text-[10px] sm:text-xs font-semibold tracking-widest text-(--color-live-bg) uppercase whitespace-nowrap">Live markets</span>
  </div>
  <div class="ticker-track">
    <div class="ticker-set">
      {pairs.map((item) => (
        <div class="flex items-center gap-1.5 sm:gap-2 px-3 sm:px-5 h-10 sm:h-11 border-r border-(--color-border) whitespace-nowrap shrink-0">
          <span class="text-[11px] sm:text-xs font-medium text-(--color-text-muted)">{item.pair}</span>
          <span class="text-[11px] sm:text-xs font-semibold text-(--color-text-primary)">{item.rate}</span>
          <ChangeIndicator isUp={item.isUp} changePercent={item.changePercent} />
        </div>
      ))}
    </div>
    <div class="ticker-set" aria-hidden="true">
      {pairs.map((item) => (
        <div class="flex items-center gap-1.5 sm:gap-2 px-3 sm:px-5 h-10 sm:h-11 border-r border-(--color-border) whitespace-nowrap shrink-0">
          <span class="text-[11px] sm:text-xs font-medium text-(--color-text-muted)">{item.pair}</span>
          <span class="text-[11px] sm:text-xs font-semibold text-(--color-text-primary)">{item.rate}</span>
          <ChangeIndicator isUp={item.isUp} changePercent={item.changePercent} />
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker-scroll 30s linear infinite;
  }
  .ticker-track:hover { animation-play-state: paused; }
  .ticker-set {
    display: flex;
    align-items: center;
  }
  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
</style>
