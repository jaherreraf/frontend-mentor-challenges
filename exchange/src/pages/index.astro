---
import Layout from "../layouts/Layout.astro"
import { getTickerPairs, getPairStats, getHistoricalRates, getDateRangeForPeriod, getCurrencies } from "../lib/api/frankfurter"
import { FROM, TO, INITIAL_RANGE, TABS } from "../lib/constants"
import MarketTicker from "../sections/MarketTicker.astro"
import ConverterCard from "../sections/ConverterCard.astro"
import RateHistoryChart from "../sections/RateHistoryChart.astro"
import CompareList from "../sections/CompareList.astro"
import FavoritesList from "../sections/FavoritesList.astro"
import ConversionLog from "../sections/ConversionLog.astro"
import TabsNav from "../components/ui/Tabs.astro"

const { startDate, endDate } = getDateRangeForPeriod(INITIAL_RANGE)

const [tickerPairs, stats, chartData, currencies] = await Promise.all([
  getTickerPairs(),
  getPairStats(FROM, TO),
  getHistoricalRates(FROM, TO, startDate, endDate),
  getCurrencies(),
])

const currencyList = Object.entries(currencies).sort(([a], [b]) => a.localeCompare(b))
const currencyCount = currencyList.length

const fxData = JSON.stringify({ chartData, endDate, from: FROM, to: TO, currencies })
---

<Layout>
  <header class="flex items-center justify-between w-full h-auto min-h-12 px-4 sm:px-6 py-2 bg-(--color-main) border-b border-(--color-border) gap-2">
    <img src="/assets/icons/logo.svg" alt="FX_CHECKER" class="h-6 sm:h-7 w-auto object-contain shrink-0" />
    <p class="text-[10px] sm:text-xs font-medium tracking-widest text-(--color-text-muted) uppercase text-right whitespace-nowrap overflow-hidden text-ellipsis">
      {currencyCount} currencies · EOD · ECB data
    </p>
  </header>

  <section aria-label="Live market rates">
    <MarketTicker pairs={tickerPairs} />
  </section>

  <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 md:px-4 py-6 sm:py-10">
    <h1 class="text-xs font-semibold tracking-widest text-(--color-text-muted) uppercase mb-4 sm:mb-6 px-1">
      Check the rate
    </h1>

    <ConverterCard {stats} from={FROM} to={TO} {currencyList} />

    <section class="mt-8 space-y-5">
      <TabsNav tabs={TABS} activeIndex={0} />

      <RateHistoryChart {stats} from={FROM} to={TO} {endDate} />
      <CompareList from={FROM} />
      <FavoritesList />
      <ConversionLog />
    </section>
  </main>

  <footer class="fixed bottom-0 left-0 right-0 z-40 group cursor-default" style="height: 0">
    <div class="absolute bottom-0 left-0 right-0 flex items-start justify-center" style="height: 48px; padding-top: 8px">
      <p
        class="text-[10px] text-(--color-text-muted) text-center
               opacity-0 group-hover:opacity-100
               transition-all duration-500 ease-in-out"
      >
        Challenge by
        <a href="https://www.frontendmentor.io" target="_blank" rel="noopener noreferrer"
           class="underline hover:text-(--color-accent-lime) transition-colors">Frontend Mentor</a>.
        Coded by
        <a href="https://github.com/Jaherreraf" target="_blank" rel="noopener noreferrer"
           class="underline hover:text-(--color-accent-lime) transition-colors">Jaherreraf</a>
      </p>
    </div>
  </footer>
  <div id="fx-data" data-fx={fxData} hidden></div>
</Layout>

<script>
  import { initConverter, getPair } from "../scripts/converter"
  import { initChart } from "../scripts/chart"
  import { initFavoritesLog, updateFavoriteBtn } from "../scripts/favorites-log"
  import { initTabs } from "../scripts/tabs"

  const el = document.getElementById("fx-data")!
  const data = JSON.parse(el.dataset.fx!)
  const { chartData, endDate, from, to, currencies } = data

  initFavoritesLog()

  initConverter({
    initialFrom: from,
    initialTo: to,
    chartData,
    onRateChange: () => updateFavoriteBtn(),
  })

  initChart({ chartData, endDate, getPair })

  initTabs({ currencies, initialFrom: from })
</script>
